+.date-range-trigger:focus-visible, .date-range-panel :focus-visible { outline: 2px solid #3186d5; outline-offset: 2px; }
+.date-range-panel { position: fixed; z-index: 1000; display: grid; grid-template-columns: minmax(0, 1fr) 220px; overflow: auto; border: 1px solid var(--color-outline-variant); border-radius: 12px; background: var(--color-surface); color: var(--color-on-surface); box-shadow: 0 12px 32px rgba(0,0,0,.13), 0 2px 6px rgba(0,0,0,.05); font-size: 13px; font-variant-numeric: tabular-nums; }
+.date-range-panel button, .date-range-panel select { cursor: pointer; }
+.date-range-panel button { transition: background-color .12s, color .12s; }
+.date-range-panel button:disabled { cursor: default; opacity: .35; }
+.date-range-calendars { min-width: 0; }
+.date-range-hint { height: 0; }
+.date-range-hint > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.date-range-hint button { position: absolute; top: 3px; right: 3px; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 6px; }
+.date-range-months { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.date-range-month { min-width: 0; padding: 8px 8px 12px; }
+.date-range-month-heading { display: flex; align-items: center; justify-content: center; gap: 3px; min-height: 40px; background: transparent; }
+.date-range-month-heading select { min-width: 0; max-width: 115px; min-height: 32px; padding: 0 4px; border-radius: 6px; color: inherit; background: transparent; font-weight: 600; text-transform: capitalize; }
+.date-range-month-heading option { background: var(--color-surface); }
+.date-range-arrow { display: grid; place-items: center; min-width: 28px; height: 32px; border-radius: 6px; }
+.date-range-weekdays, .date-range-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; }
+.date-range-weekdays { padding: 10px 0 8px; text-align: center; color: var(--color-on-surface-variant); font-weight: 600; }
+.date-range-days button { min-height: 32px; width: 100%; border-radius: 6px; font-size: 12px; }
+.date-range-days .outside { color: var(--color-outline); }
+.date-range-days .duplicate { visibility: hidden; }
+.date-range-days .selected { color: #fff; background: #3284d0; }
+.date-range-days .endpoint, .date-range-days [aria-current=date] { font-weight: 800; }
+.date-range-days button:hover:not(:disabled):not(.selected), .date-range-arrow:hover:not(:disabled), .date-range-hint button:hover { background: var(--color-surface-container); }
+.date-range-days .selected:hover { background: #246cb0; }
+.date-range-presets { padding: 10px 8px; border-left: 1px solid var(--color-outline-variant); background: var(--color-surface-container-low); }
+.date-range-presets h3 { margin: 0 0 6px; padding-right: 24px; font-weight: 600; font-size: 13px; }
+.date-range-presets > button { display: block; width: 100%; min-height: 35px; padding: 7px 10px; border-radius: 6px; text-align: left; font-weight: 600; }
+.date-range-presets > button:hover, .date-range-presets > button[aria-pressed=true] { background: var(--color-surface-container); }
+.date-range-presets .date-range-period-title { margin-top: 10px; }
+.date-range-periods { display: flex; gap: 4px; }
+.date-range-periods button, .date-range-periods input { width: 42px; height: 32px; border: 1px solid var(--color-outline-variant); border-radius: 7px; text-align: center; background: var(--color-surface); }
+.date-range-periods form { min-width: 0; flex: 1; }
+.date-range-periods input { width: 100%; min-width: 0; padding: 0 4px; }
+@media (max-width: 800px) {
+  .date-range-panel { grid-template-columns: minmax(0, 1fr); }
+  .date-range-presets { border-left: 0; border-top: 1px solid var(--color-outline-variant); }
+  .date-range-presets > button { display: inline-block; width: 50%; font-size: 12px; }
+  .date-range-periods { max-width: 320px; }
+}
+@media (max-width: 580px) {
+  .date-range-months { grid-template-columns: minmax(0, 1fr); }
+  .date-range-month-heading { justify-content: space-between; }
+  .date-range-days button { min-height: 40px; }
+}
+
+@media (pointer: coarse) {
+  .date-range-days button, .date-range-arrow, .date-range-month-heading select, .date-range-presets > button, .date-range-periods button, .date-range-periods input { min-height: 40px; }
+}
diff --git a/frontend/src/components/DateRangePicker.jsx b/frontend/src/components/DateRangePicker.jsx
new file mode 100644
index 0000000..4b442d0
--- /dev/null
+++ b/frontend/src/components/DateRangePicker.jsx
@@ -0,0 +1,128 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { CalendarBlank, CaretLeft, CaretRight, CaretDown, X } from '@phosphor-icons/react';
+import { useI18n } from '../utils/i18n.jsx';
+import { isoDay, ruDate } from '../utils/formats.js';
+import { dayDate, monthDays, monthStart, presetRange, shiftDay } from '../utils/dateRange.js';
+import './DateRangePicker.css';
+
+const PRESETS = ['yesterday', 'week', 'previousWeek', 'month', 'previousMonth', 7, 30, 90];
+const TEXT = {
+  ru: { title: 'Выбор периода', quick: 'Быстрый выбор', period: 'Период', start: 'Выберите начало периода', end: 'Выберите конец периода', close: 'Закрыть', previous: 'Предыдущий месяц', next: 'Следующий месяц', monthLabel: 'Месяц', year: 'Год', custom: 'Количество дней', days: 'д', weeks: 'н', months: 'м', weekdays: ['пн', 'вт', 'ср', 'чт', 'пт', 'сб', 'вс'], presets: ['Вчера', 'Текущая неделя', 'Предыдущая неделя', 'Текущий месяц', 'Предыдущий месяц', 'Последние 7 дней', 'Последние 30 дней', 'Последние 90 дней'] },
+  en: { title: 'Choose date range', quick: 'Quick select', period: 'Period', start: 'Choose the start date', end: 'Choose the end date', close: 'Close', previous: 'Previous month', next: 'Next month', monthLabel: 'Month', year: 'Year', custom: 'Number of days', days: 'd', weeks: 'w', months: 'm', weekdays: ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'], presets: ['Yesterday', 'This week', 'Previous week', 'This month', 'Previous month', 'Last 7 days', 'Last 30 days', 'Last 90 days'] },
+};
+
+export default function DateRangePicker({ dateFrom, dateTo, onChange }) {
+  const { lang } = useI18n();
+  const text = TEXT[lang] || TEXT.ru;
+  const locale = lang === 'en' ? 'en-GB' : 'ru-RU';
+  const today = isoDay();
+  const id = useId();
+  const trigger = useRef(null), panel = useRef(null);
+  const [open, setOpen] = useState(false);
+  const [month, setMonth] = useState(() => monthStart(dateTo));
+  const [anchor, setAnchor] = useState(null), [hover, setHover] = useState(null);
+  const [custom, setCustom] = useState('');
+  const [position, setPosition] = useState({});
+  const close = () => { setOpen(false); setAnchor(null); setHover(null); trigger.current?.focus(); };
+  const apply = (from, to) => { onChange({ dateFrom: from, dateTo: to }); close(); };
+  const choosePreset = (key) => apply(...presetRange(key, today));
+
+  useEffect(() => {
+    if (!open) return;
+    const place = () => {
+      const rect = trigger.current.getBoundingClientRect();
+      const width = Math.min(780, window.innerWidth - 24);
+      setPosition({ left: Math.max(12, Math.min(rect.left, window.innerWidth - width - 12)), top: Math.min(rect.bottom + 8, Math.max(12, window.innerHeight - 220)), width, maxHeight: Math.max(180, window.innerHeight - rect.bottom - 20) });
+    };
+    place();
+    panel.current?.focus();
+    const outside = (event) => { if (!panel.current?.contains(event.target) && !trigger.current?.contains(event.target)) { setOpen(false); setAnchor(null); setHover(null); } };
+    document.addEventListener('pointerdown', outside);
+    window.addEventListener('resize', place);
+    window.addEventListener('scroll', place, true);
+    return () => { document.removeEventListener('pointerdown', outside); window.removeEventListener('resize', place); window.removeEventListener('scroll', place, true); };
+  }, [open]);
+
+  // A first click only starts a draft. Fetch analytics once the complete range is chosen.
+  const chooseDay = (day) => {
+    if (!anchor) { setAnchor(day); setHover(day); }
+    else apply(day < anchor ? day : anchor, day < anchor ? anchor : day);
+  };
+  const from = anchor ? (hover && hover < anchor ? hover : anchor) : dateFrom;
+  const to = anchor ? (hover && hover > anchor ? hover : anchor) : dateTo;
+  const months = Array.from({ length: 12 }, (_, i) => new Intl.DateTimeFormat(locale, { month: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, i, 1))));
+  const years = Array.from({ length: Math.max(12, Number(today.slice(0, 4)) - 2014) }, (_, i) => Number(today.slice(0, 4)) - i);
+  const keyDay = (event, day) => {
+    const offset = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[event.key];
+    if (offset == null) return;
+    event.preventDefault();
+    const next = shiftDay(day, offset);
+    if (next > today) return;
+    const element = panel.current.querySelector(`button[data-day="${next}"]:not([data-outside="true"])`);
+    if (element) element.focus();
+    else { setMonth(monthStart(next)); requestAnimationFrame(() => panel.current?.querySelector(`button[data-day="${next}"]:not([data-outside="true"])`)?.focus()); }
+    if (anchor) setHover(next);
+  };
+
+  return <>
+    <button ref={trigger} type="button" className="date-range-trigger" aria-haspopup="dialog" aria-expanded={open} aria-controls={open ? id : undefined}
+      onClick={() => { if (open) close(); else { setMonth(monthStart(dateTo)); setAnchor(null); setHover(null); setOpen(true); } }}>
+      <CalendarBlank size={21} aria-hidden="true" />
+      <span>{ruDate(dateFrom).replace(/\.20(\d\d)$/, '.$1')} — {ruDate(dateTo).replace(/\.20(\d\d)$/, '.$1')}</span>
+      <CaretDown size={14} aria-hidden="true" />
+    </button>
+    {open && createPortal(<div ref={panel} id={id} role="dialog" aria-label={text.title} tabIndex={-1} className="date-range-panel" style={position}
+      onKeyDown={event => {
+        if (event.key === 'Escape') { event.preventDefault(); close(); }
+        if (event.key === 'Tab') {
+          const elements = [...panel.current.querySelectorAll('button:not(:disabled), select, input')];
+          const first = elements[0], last = elements[elements.length - 1];
+          if (event.shiftKey && (document.activeElement === first || document.activeElement === panel.current)) { event.preventDefault(); last.focus(); }
+          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
+        }
+      }}>
+      <div className="date-range-calendars">
+        <div className="date-range-hint"><span aria-live="polite">{anchor ? text.end : text.start}</span><button type="button" aria-label={text.close} onClick={close}><X size={18} /></button></div>
+        <div className="date-range-months">
+          {[0, 1].map(index => {
+            const displayed = monthStart(month, index), date = dayDate(displayed);
+            return <section key={index} className="date-range-month" aria-label={`${months[date.getUTCMonth()]} ${date.getUTCFullYear()}`}>
+              <div className="date-range-month-heading">
+                {index === 0 && <button type="button" className="date-range-arrow" aria-label={text.previous} onClick={() => setMonth(monthStart(month, -1))}><CaretLeft size={18} /></button>}
+                <select aria-label={`${text.monthLabel} ${index + 1}`} value={date.getUTCMonth()} onChange={e => setMonth(monthStart(`${date.getUTCFullYear()}-${String(Number(e.target.value) + 1).padStart(2, '0')}-01`, -index))}>
+                  {months.map((name, i) => <option key={name} value={i}>{name}</option>)}
+                </select>
+                <select aria-label={`${text.year} ${index + 1}`} value={date.getUTCFullYear()} onChange={e => setMonth(monthStart(`${e.target.value}-${displayed.slice(5, 7)}-01`, -index))}>
+                  {[...new Set([date.getUTCFullYear(), ...years])].sort((a, b) => b - a).map(year => <option key={year}>{year}</option>)}
+                </select>
+                {index === 1 && <button type="button" className="date-range-arrow" aria-label={text.next} disabled={month >= monthStart(today)} onClick={() => setMonth(monthStart(month, 1))}><CaretRight size={18} /></button>}
+              </div>
+              <div className="date-range-weekdays">{text.weekdays.map(day => <span key={day}>{day}</span>)}</div>
+              <div className="date-range-days" onMouseLeave={() => setHover(null)}>{monthDays(displayed).map(day => {
+                const outside = day.slice(0, 7) !== displayed.slice(0, 7), selected = day >= from && day <= to;
+                const duplicate = index === 1 ? day < displayed : day >= monthStart(displayed, 1);
+                return <button key={day} type="button" data-day={day} data-outside={outside} disabled={day > today || duplicate} aria-hidden={duplicate || undefined} aria-label={ruDate(day)} aria-pressed={selected} aria-current={day === today ? 'date' : undefined}
+                  className={`${duplicate ? 'duplicate' : ''} ${outside ? 'outside' : ''} ${selected ? 'selected' : ''} ${day === from || day === to ? 'endpoint' : ''}`}
+                  onClick={() => chooseDay(day)} onMouseEnter={() => anchor && setHover(day)} onFocus={() => anchor && setHover(day)} onKeyDown={e => keyDay(e, day)}>{Number(day.slice(8))}</button>;
+              })}</div>
+            </section>;
+          })}
+        </div>
+      </div>
+      <aside className="date-range-presets">
+        <h3>{text.quick}</h3>
+        {PRESETS.map((key, i) => { const range = presetRange(key, today); return <button type="button" key={key} aria-pressed={!anchor && dateFrom === range[0] && dateTo === range[1]} onClick={() => choosePreset(key)}>{text.presets[i]}</button>; })}
+        <h3 className="date-range-period-title">{text.period}</h3>
+        <div className="date-range-periods">
+          <button type="button" onClick={() => choosePreset(7)}>7{text.days}</button>
+          <button type="button" onClick={() => choosePreset(28)}>4{text.weeks}</button>
+          <button type="button" onClick={() => choosePreset('quarter')}>3{text.months}</button>
+          <form onSubmit={e => { e.preventDefault(); const days = Number(custom); if (Number.isInteger(days) && days > 0 && days <= 36500) choosePreset(days); }}>
+            <input aria-label={text.custom} type="number" min="1" max="36500" placeholder={`42${text.days}`} value={custom} onChange={e => setCustom(e.target.value)} />
+          </form>
+        </div>
+      </aside>
+    </div>, document.body)}
+  </>;
+}
diff --git a/frontend/src/components/ExpenseForm.jsx b/frontend/src/components/ExpenseForm.jsx
new file mode 100644
index 0000000..7be12ba
--- /dev/null
+++ b/frontend/src/components/ExpenseForm.jsx
@@ -0,0 +1,90 @@
+import { useRef, useState } from "react";
+import { request } from "../utils/api.js";
+
+const inputClass = "w-full min-h-10 px-3 py-2 rounded-lg bg-[var(--color-surface-container)] border border-[var(--color-outline-variant)] text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]";
+
+function currentDay() {
+  const parts = new Intl.DateTimeFormat("en", { timeZone: "Europe/Moscow", year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(new Date());
+  return `${parts.find((p) => p.type === "year").value}-${parts.find((p) => p.type === "month").value}-${parts.find((p) => p.type === "day").value}`;
+}
+
+export default function ExpenseForm({ onSaved }) {
+  const [expenseDate, setExpenseDate] = useState(currentDay);
+  const [category, setCategory] = useState("");
+  const [amount, setAmount] = useState("");
+  const [description, setDescription] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [message, setMessage] = useState("");
+  const submitting = useRef(false);
+
+  async function submit(event) {
+    event.preventDefault();
+    if (submitting.current) return;
+    setError("");
+    setMessage("");
+    const normalized = amount.replace(/\s/g, "").replace(",", ".");
+    if (!category.trim()) {
+      setError("Укажите категорию расхода.");
+      return;
+    }
+    if (!/^\d+(\.\d{1,2})?$/.test(normalized) || !Number.isFinite(Number(normalized)) || Number(normalized) <= 0) {
+      setError("Укажите сумму больше нуля, не более двух знаков после запятой.");
+      return;
+    }
+    if (!/^\d{4}-(0[1-9]|1[0-2])-\d{2}$/.test(expenseDate) || Number.isNaN(Date.parse(expenseDate))) {
+      setError("Укажите корректную дату расхода.");
+      return;
+    }
+    submitting.current = true;
+    setBusy(true);
+    try {
+      const expense = await request("/api/v1/pnl/expenses", {
+        admin: true, method: "POST",
+        body: { expense_date: expenseDate, category: category.trim(), amount_rub: Number(normalized), description: description.trim() },
+      });
+      onSaved(expense);
+      setCategory("");
+      setAmount("");
+      setDescription("");
+      setMessage("Расход сохранён. Месячный P&L учитывает изменения после пересчёта отчёта.");
+    } catch (err) {
+      setError(err.status === 403 ? "Для добавления расходов нужны права администратора организации." : `Не удалось сохранить расход. ${err.message}`);
+    } finally {
+      submitting.current = false;
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form onSubmit={submit} className="md3-card-elevated p-4 space-y-3" aria-label="Добавить внешний расход">
+      <div>
+        <h3 className="text-sm font-semibold">Добавить внешний расход</h3>
+        <p className="text-xs text-[var(--color-on-surface-variant)] mt-1">Общий расход организации за выбранный день: аренда, зарплата, услуги и другие затраты.</p>
+      </div>
+      <fieldset disabled={busy} className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 disabled:opacity-60">
+        <label className="block space-y-1 text-sm">
+          <span>Дата расхода</span>
+          <input className={inputClass} type="date" required min="1970-01-01" max="2149-06-06" value={expenseDate} onChange={(e) => setExpenseDate(e.target.value)} />
+        </label>
+        <label className="block space-y-1 text-sm">
+          <span>Категория</span>
+          <input className={inputClass} required maxLength={100} placeholder="Например, аренда" value={category} onChange={(e) => setCategory(e.target.value)} />
+        </label>
+        <label className="block space-y-1 text-sm">
+          <span>Сумма, ₽</span>
+          <input className={`${inputClass} tabular-nums`} required inputMode="decimal" placeholder="0,00" value={amount} onChange={(e) => setAmount(e.target.value)} />
+        </label>
+        <label className="block space-y-1 text-sm">
+          <span>Комментарий (необязательно)</span>
+          <input className={inputClass} maxLength={500} value={description} onChange={(e) => setDescription(e.target.value)} />
+        </label>
+        <button type="submit" className="min-h-10 justify-self-start px-4 py-2 rounded-lg bg-[var(--color-primary)] text-[var(--color-on-primary)] text-sm font-semibold active:scale-[0.96] transition-transform disabled:cursor-wait">
+          {busy ? "Сохранение…" : "Добавить расход"}
+        </button>
+      </fieldset>
+      {error && <p role="alert" className="text-sm text-[var(--color-error)]">{error}</p>}
+      <p role="status" className="text-sm text-[var(--color-on-surface-variant)]">{message}</p>
+    </form>
+  );
+}
