+++ b/backend/app/services/daily_pnl_service.py
@@ -0,0 +1,145 @@
+"""Daily dashboard P&L; calendar allocation is explicit and cent-exact."""
+import calendar
+import json
+import os
+from collections import defaultdict
+from datetime import date, timedelta
+from decimal import Decimal, ROUND_HALF_UP
+
+from common.article_economics import AccrualEconomics
+from common.pnl_tax import tax_amount
+from app.services.pnl_service import PnlService
+
+CENT = Decimal('0.01')
+
+
+def allocate(amount, weights):
+    """Allocate a monthly amount with deterministic rounding; signed returns are allowed."""
+    total = sum(weights, Decimal(0))
+    if not total:
+        weights = [Decimal(1)] * len(weights)
+        total = Decimal(len(weights))
+    parts = [(amount * w / total).quantize(CENT, rounding=ROUND_HALF_UP) for w in weights]
+    if parts:
+        parts[-1] += amount - sum(parts)
+    return parts
+
+
+class DailyPnlService:
+    def __init__(self, ch, organization_id):
+        self.ch, self.org = ch, organization_id
+
+    def build(self, start, stop, marketplace='', account_id=''):
+        first = start.replace(day=1)
+        last = stop.replace(day=calendar.monthrange(stop.year, stop.month)[1])
+        params = dict(oid=self.org, start=first, stop=last, mp=marketplace, aid=account_id)
+        scope = " AND (marketplace,account_id) IN (SELECT marketplace,account_id FROM dim_account FINAL WHERE organization_id={oid:String}) AND ({mp:String}='' OR marketplace={mp:String}) AND ({aid:String}='' OR account_id={aid:String})"
+        accounts = list(self.ch.query("SELECT marketplace,account_id FROM dim_account FINAL WHERE organization_id={oid:String} AND ({mp:String}='' OR marketplace={mp:String}) AND ({aid:String}='' OR account_id={aid:String})", parameters=params).result_rows)
+        rows = defaultdict(lambda: dict(revenue=Decimal(0), net_accrued=Decimal(0), cogs=Decimal(0), ads=Decimal(0), buyer=Decimal(0), tax=Decimal(0), external=Decimal(0), qty=Decimal(0), missing_costs=0, tax_status='disabled'))
+        for r in self.ch.query("SELECT day,marketplace,account_id,sales+returns AS revenue,net_accrued,if(marketplace='ozon',-details['loans_and_factoring'],0) AS financing,if(marketplace='ozon',-details['pay_per_click'],0) AS ads FROM mrt_finance_daily FINAL WHERE day BETWEEN {start:Date} AND {stop:Date}" + scope, parameters=params).named_results():
+            target = rows[(str(r['day']), r['marketplace'], r['account_id'])]
+            for k in ('revenue','net_accrued'):
+                target[k] += Decimal(str(r[k]))
+            target['ads'] += Decimal(str(r.get('ads') or 0))
+            target['net_accrued'] += Decimal(str(r.get('financing') or 0))
+        # Same COGS fallback as monthly P&L; never silently hide missing costs.
+        sql = """SELECT s.day AS day,s.marketplace AS marketplace,s.account_id AS account_id,
+            sum(s.qty) AS qty,
+            sum(s.qty * if(ifNull(oc.cost_price_rub,0)>0,oc.cost_price_rub,ifNull(c.cost_price_rub,0))) AS cogs,
+            countIf(s.qty!=0 AND ifNull(oc.cost_price_rub,0)<=0 AND ifNull(c.cost_price_rub,0)<=0) AS missing_costs
+            FROM stg_sales AS s FINAL
+            LEFT JOIN dim_product_cost AS c FINAL ON s.marketplace=c.marketplace AND s.product_id=toString(c.product_id)
+            LEFT JOIN v_offer_cost AS oc ON s.marketplace=oc.marketplace AND s.account_id=oc.account_id AND s.product_id=oc.product_id
+            WHERE s.day BETWEEN {start:Date} AND {stop:Date}
+            AND (s.marketplace,s.account_id) IN (SELECT marketplace,account_id FROM dim_account FINAL WHERE organization_id={oid:String})
+            AND ({mp:String}='' OR s.marketplace={mp:String}) AND ({aid:String}='' OR s.account_id={aid:String})
+            GROUP BY s.day,s.marketplace,s.account_id"""
+        for r in self.ch.query(sql, parameters=params).named_results():
+            target=rows[(str(r['day']),r['marketplace'],r['account_id'])]
+            for k in ('qty','cogs'):
+                target[k] += Decimal(str(r[k]))
+            target['missing_costs'] += r['missing_costs']
+        # Buyer prices and signed returns, not seller prices or payouts.
+        for mp, aid in accounts:
+            if mp != 'ozon':
+                continue
+            p = {**params, 'account':aid}
+            engines = defaultdict(AccrualEconomics)
+            for r in self.ch.query("SELECT payload FROM raw_ozon_finance_ops FINAL WHERE account_id={account:String} AND source='accrual_by_day' AND operation_ts>=toDateTime({start:Date},'Europe/Moscow') AND operation_ts<toDateTime(addDays({stop:Date},1),'Europe/Moscow')",parameters=p).named_results():
+                payload=json.loads(r['payload'],parse_float=Decimal)
+                engines[str(payload['date'])[:10]].add(payload)
+            domestic={k:v for engine in engines.values() for k,v in engine.domestic_sales.items()}
+            seen={}
+            for r in self.ch.query("SELECT day,payload FROM raw_ozon_buyouts_daily FINAL WHERE account_id={account:String} AND day BETWEEN {start:Date} AND {stop:Date} ORDER BY day",parameters=p).named_results():
+                engine=engines[str(r['day'])]
+                engine.domestic_sales.update(domestic)
+                engine.seen_buyouts=seen
+                payload=json.loads(r['payload'],parse_float=Decimal)
+                payload['products']=[v for v in payload['products'] if (str(v.get('posting_number')),str(v.get('sku'))) not in domestic]
+                engine.add_buyouts(r['day'],payload)
+            for day,engine in engines.items():
+                rows[(day,mp,aid)]['buyer']=sum((v['buyer_revenue'] for v in engine.rows.values()),Decimal(0))
+        monthly = {(r.month[:7],r.marketplace,r.account_id):r for r in PnlService(self.ch,self.org).get_pnl(first,last,marketplace,account_id) if r.marketplace}
+        from app.services.ozon_cis_service import cis_adjustments
+        for mp, aid in accounts:
+            if mp == 'ozon':
+                for day, extra in cis_adjustments(self.ch, aid, first, last).items():
+                    target = rows[(day,mp,aid)]
+                    target['revenue'] += extra['revenue']
+                    target['net_accrued'] += extra['receipts']
+                    target['cogs'] += extra['cogs']
+                    target['qty'] += extra['qty']
+        month=first
+        while month<=last:
+            count=calendar.monthrange(month.year,month.month)[1]
+            days=[month+timedelta(days=i) for i in range(count)]
+            for mp,aid in accounts:
+                keys=[(d.isoformat(),mp,aid) for d in days]
+                monthly_row=monthly.get((month.isoformat()[:7],mp,aid))
+                enabled=(os.getenv('PNL_REALIZATION_TAX_ENABLED','false').lower()=='true' and self.org==os.getenv('PNL_TAX_ORGANIZATION_ID','default') and mp=='ozon' and aid==os.getenv('PNL_TAX_ACCOUNT_ID','default'))
+                if enabled:
+                    weights=[rows[k]['buyer'] for k in keys]
+                    confirmed=monthly_row is not None and monthly_row.tax_status=='confirmed'
+                    amount=Decimal(str(monthly_row.tax_rub)) if confirmed else tax_amount(sum(weights),Decimal(os.getenv('PNL_TAX_RATE_PCT','8')))
+                    for key,part in zip(keys,allocate(amount,weights)):
+                        rows[key]['tax']=part
+                        rows[key]['tax_status']='allocated_report' if confirmed else 'estimated'
+            month=(month.replace(day=28)+timedelta(days=4)).replace(day=1)
+        external=defaultdict(Decimal)
+        for r in self.ch.query("SELECT month,expense_date,amount_rub FROM dim_additional_expense FINAL WHERE organization_id={oid:String} AND month BETWEEN {start:Date} AND {stop:Date}",parameters=params).named_results():
+            if r.get('expense_date') is not None:
+                external[str(r['expense_date'])] += Decimal(str(r['amount_rub']))
+                continue
+            month=r['month']
+            if isinstance(month,str): month=date.fromisoformat(month)
+            count=calendar.monthrange(month.year,month.month)[1]
+            for i,part in enumerate(allocate(Decimal(str(r['amount_rub'])),[Decimal(1)]*count)):
+                external[(month+timedelta(days=i)).isoformat()]+=part
+        items=[]
+        stocks={}
+        stock_sql="""SELECT s.day AS day,sum(s.stock_end) AS stock,
+            sum(s.stock_end * if(ifNull(oc.cost_price_rub,0)>0,oc.cost_price_rub,ifNull(c.cost_price_rub,0))) AS stock_cost
+            FROM mrt_stock_daily AS s FINAL
+            LEFT JOIN dim_product_cost AS c FINAL ON s.marketplace=c.marketplace AND s.product_id=toString(c.product_id)
+            LEFT JOIN v_offer_cost AS oc ON s.marketplace=oc.marketplace AND s.account_id=oc.account_id AND s.product_id=oc.product_id
+            WHERE s.day BETWEEN {start:Date} AND {stop:Date}
+            AND (s.marketplace,s.account_id) IN (SELECT marketplace,account_id FROM dim_account FINAL WHERE organization_id={oid:String})
+            AND ({mp:String}='' OR s.marketplace={mp:String}) AND ({aid:String}='' OR s.account_id={aid:String}) GROUP BY s.day"""
+        for r in self.ch.query(stock_sql,parameters=params).named_results():
+            stocks[str(r['day'])]=r
+        for i in range((stop-start).days+1):
+            day=(start+timedelta(days=i)).isoformat()
+            parts=[rows[(day,mp,aid)] for mp,aid in accounts]
+            result={k:sum((r[k] for r in parts),Decimal(0)) for k in ('revenue','net_accrued','cogs','ads','buyer','tax','qty')}
+            result['external']=external[day] if accounts else Decimal(0)
+            # net_accrued already includes every marketplace charge, including ads.
+            # Performance statistics are attribution data, not another expense.
+            result['before_tax']=result['net_accrued']-result['cogs']-result['external']
+            result['profit']=result['before_tax']-result['tax']
+            result['missing_costs']=sum(r['missing_costs'] for r in parts)
+            result['stock']=stocks.get(day,{}).get('stock')
+            result['stock_cost']=stocks.get(day,{}).get('stock_cost')
+            active=[r for r in parts if any(r[k] for k in ('revenue','buyer','net_accrued','cogs','ads','tax'))]
+            result['tax_status']='estimated' if any(r['tax_status']=='estimated' for r in active) else 'allocated_report' if active and all(r['tax_status']=='allocated_report' for r in active) else 'disabled'
+            items.append(dict(day=day,**{k:float(v) if isinstance(v,Decimal) else v for k,v in result.items()}))
+        return dict(items=items, notes=['Внешние расходы с датой учитываются целиком в указанный день. Старые расходы без даты распределены поровну по календарным дням месяца; при фильтре кабинета учитываются общие расходы организации.', 'Налог по ценам покупателя за вычетом возвратов; после полного отчёта месячный налог распределяется по дневной базе. Остатки — последний снимок на выбранную дату.'])
diff --git a/backend/app/services/ozon_cis_service.py b/backend/app/services/ozon_cis_service.py
new file mode 100644
index 0000000..74ddcc6
--- /dev/null
+++ b/backend/app/services/ozon_cis_service.py
@@ -0,0 +1,54 @@
+"""Additional CIS receipts and COGS absent from domestic sale accruals."""
+import json
+from collections import defaultdict
+from decimal import Decimal
+
+from common.article_economics import AccrualEconomics, number
+from common.ozon_buyouts import parse_buyouts
+
+
+def cis_adjustments(ch, account_id, start, stop):
+    params = dict(aid=account_id, start=start, stop=stop)
+    snapshots = list(ch.query(
+        "SELECT day,payload FROM raw_ozon_buyouts_daily FINAL WHERE account_id={aid:String}"
+        " AND day BETWEEN {start:Date} AND {stop:Date} ORDER BY day", parameters=params,
+    ).named_results())
+    if not snapshots:
+        return {}
+    postings = sorted({record['posting_number'] for snapshot in snapshots
+        for record in parse_buyouts(json.loads(snapshot['payload'], parse_float=Decimal))})
+    if not postings:
+        return {}
+    params['postings'] = postings
+    engine = AccrualEconomics()
+    for row in ch.query(
+        "SELECT payload FROM raw_ozon_finance_ops FINAL WHERE account_id={aid:String}"
+        " AND source='accrual_by_day' AND operation_ts>=toDateTime({start:Date},'Europe/Moscow')"
+        " AND operation_ts<toDateTime(addDays({stop:Date},1),'Europe/Moscow')"
+        " AND JSONExtractString(payload,'unit_number') IN {postings:Array(String)}", parameters=params,
+    ).named_results():
+        engine.add(json.loads(row['payload'], parse_float=Decimal))
+    costs = {str(r['product_id']): number(r['cost']) for r in ch.query(
+        "SELECT p.product_id AS product_id,"
+        " if(ifNull(oc.cost_price_rub,0)>0,oc.cost_price_rub,ifNull(c.cost_price_rub,0)) AS cost"
+        " FROM dim_product AS p FINAL LEFT JOIN v_offer_cost AS oc"
+        " ON p.marketplace=oc.marketplace AND p.account_id=oc.account_id AND p.product_id=oc.product_id"
+        " LEFT JOIN dim_product_cost AS c FINAL ON p.marketplace=c.marketplace AND p.product_id=toString(c.product_id)"
+        " WHERE p.marketplace='ozon' AND p.account_id={aid:String}", parameters=params,
+    ).named_results()}
+    result = defaultdict(lambda: dict(receipts=Decimal(0), cogs=Decimal(0), qty=Decimal(0), revenue=Decimal(0), commission=Decimal(0)))
+    for row in snapshots:
+        before = {sku: r['sales_qty']+r['returns_qty']+r['sales_cis'] for sku,r in engine.rows.items()}
+        revenue = sum(v["revenue"] for v in engine.rows.values())
+        commission = sum(v["commission"] for v in engine.rows.values())
+        receipts = engine.buyout_receipts
+        engine.add_buyouts(row['day'], json.loads(row['payload'], parse_float=Decimal))
+        target = result[str(row['day'])]
+        target['revenue'] += sum(v['revenue'] for v in engine.rows.values())-revenue
+        target['commission'] += sum(v['commission'] for v in engine.rows.values())-commission
+        target['receipts'] += engine.buyout_receipts-receipts
+        for sku,r in engine.rows.items():
+            units = r['sales_qty']+r['returns_qty']+r['sales_cis']-before.get(sku,Decimal(0))
+            target['qty'] += units
+            target['cogs'] += units*costs.get(sku,Decimal(0))
+    return result
diff --git a/collectors/ozon/sku_ad_reports.py b/collectors/ozon/sku_ad_reports.py
new file mode 100644
index 0000000..8ed57e2
--- /dev/null
+++ b/collectors/ozon/sku_ad_reports.py
@@ -0,0 +1,75 @@
+"""Historical Performance API reports: only explicit SKU rows are attributable."""
+import time
+import hashlib
+from datetime import UTC, datetime
+from decimal import Decimal
+from zoneinfo import ZoneInfo
+
+
+def report_is_fresh(updated_at, today):
+    """Reuse a completed report within one Moscow day; refresh later corrections."""
+    stamp = updated_at if updated_at.tzinfo else updated_at.replace(tzinfo=UTC)
+    return stamp.astimezone(ZoneInfo('Europe/Moscow')).date() == today
+
+
+def decimal_value(value):
+    value = str(value or '0').replace('\u00a0','').replace(' ','').replace(',','.')
+    result = Decimal(value)
+    if not result.is_finite():
+        raise ValueError('Invalid Performance cost')
+    return result
+
+
+def parse_report(data, campaigns, start, stop):
+    result = {}
+    for campaign in campaigns:
+        block = data.get(str(campaign))
+        if not isinstance(block,dict) or not isinstance(block.get('report'),dict):
+            raise ValueError(f'Performance report missing campaign {campaign}')
+        report = block['report']
+        rows = report.get('rows')
+        if not isinstance(rows,list):
+            raise ValueError('Performance report rows are missing')
+        known = Decimal(0)
+        for row in rows:
+            raw_sku = str(row.get('sku') or '')
+            if not raw_sku.isdigit() or int(raw_sku)<=0:
+                continue
+            day = datetime.strptime(row['date'],'%d.%m.%Y').date()
+            if not start <= day <= stop:
+                raise ValueError('Performance report returned a date outside its period')
+            amount = decimal_value(row.get('moneySpent'))
+            key = (day,str(campaign),raw_sku)
+            result[key] = result.get(key,Decimal(0)) + amount
+            known += amount
+        # Daily SKU rows and campaign totals can differ after corrections, not only
+        # rounding (observed in real 2025 reports). Keep explicit SKU rows unchanged.
+        # Finance-versus-SKU differences remain on the unmatched expense article.
+    return result
+
+
+def cache_key(account,campaigns,start,stop):
+    return hashlib.sha256(('|'.join([account,start.isoformat(),stop.isoformat(),*sorted(campaigns)])).encode()).hexdigest()
+
+
+def fetch_report(client, campaigns, start, stop, job_uuid=None, on_created=None):
+    headers={'Authorization':'Bearer '+client._access_token(),'Accept':'application/json'}
+    uuid=job_uuid
+    if not uuid:
+        job=client.http.post('/api/client/statistics/json',headers=headers,json={
+            'campaigns':campaigns,'dateFrom':start.isoformat(),'dateTo':stop.isoformat(),'groupBy':'DATE'})
+        uuid=job.get('UUID')
+    if not uuid:
+        raise ValueError('Performance did not return a report UUID')
+    if on_created:
+        on_created(uuid)
+    deadline=time.monotonic()+600
+    while time.monotonic()<deadline:
+        state=client._get('/api/client/statistics/'+uuid,{})
+        if state.get('state')=='OK':
+            data=client._get('/api/client/statistics/report',{'UUID':uuid})
+            return parse_report(data,campaigns,start,stop),uuid,data
+        if state.get('state') in {'ERROR','FAILED'}:
+            raise RuntimeError('Performance report generation failed: '+str(state.get('error') or 'unknown error'))
+        time.sleep(5)
+    raise TimeoutError('Performance report not ready within 10 minutes')
diff --git a/common/article_economics.py b/common/article_economics.py
new file mode 100644
index 0000000..477fcae
--- /dev/null
+++ b/common/article_economics.py
@@ -0,0 +1,179 @@
+"""Article economics from signed Ozon accruals; missing inputs remain unavailable."""
+from collections import defaultdict
+from decimal import Decimal
+
+ZERO = Decimal(0)
+CENT = Decimal('0.01')
+EXPENSES = ('delivery', 'partners', 'promotion', 'fbo', 'other_services', 'compensation', 'other_accruals', 'marketing')
+MARKETING = {3, 4, 5, 19, 23, 31, 33, 41, 47, 48, 49, 50, 54, 55, 61, 70, 75, 80, 87, 95, 96, 116, 130}
+DELIVERY = {2, 6, 9, 28, 29, 30, 32, 40, 45, 53, 59, 62, 64, 65, 67, 71, 73, 98, 99, 100, 110, 111, 112, 113, 114, 115, 120, 121, 124}
+PARTNERS = {1, 13, 16, 17, 42, 43, 44, 56, 63, 66, 68, 97, 106, 107, 108, 109, 122, 123}
+FBO = {12, 21, 46, 58, 60, 77, 78, 79, 101, 102, 103, 131, 132, 133, 134, 135}
+COMPENSATION = {10, 25, 81, 104}
+
+
+def number(value):
+    if isinstance(value, dict):
+        value = value.get('amount')
+    if value is None:
+        return ZERO
+    result = Decimal(str(value))
+    if not result.is_finite():
+        raise ValueError('Non-finite financial amount')
+    return result
+
+
+def category(type_id):
+    n = int(type_id or 0)
+    return ('marketing' if n in MARKETING else 'delivery' if n in DELIVERY else
+            'partners' if n in PARTNERS else 'fbo' if n in FBO else
+            'compensation' if n in COMPENSATION else 'other_services')
+
+
+class AccrualEconomics:
+    def __init__(self):
+        self.rows = defaultdict(lambda: defaultdict(lambda: ZERO))
+        self.pool = defaultdict(lambda: ZERO)
+        self.raw_total = ZERO
+        self.operations = 0
+        self.sale_days = defaultdict(lambda: defaultdict(lambda: ZERO))
+        self.campaign_charges = defaultdict(lambda: ZERO)
+        self.domestic_sales = defaultdict(lambda: defaultdict(lambda: ZERO))
+        self.buyout_receipts=ZERO
+        self.buyout_overlap_count=0
+        self.cis_sale_days=defaultdict(lambda: defaultdict(lambda: ZERO))
+        self.seen_buyouts={}
+
+    def fee(self, sku, fee):
+        target = self.rows[str(sku)] if sku else self.pool
+        target[category(fee.get('type_id'))] -= number(fee.get('accrued'))
+
+    def add(self, payload):
+        before = self.net()
+        self.raw_total += number(payload.get('total_amount'))
+        self.operations += 1
+        posting = payload.get('posting') or {}
+        for p in posting.get('products') or []:
+            sku = str(p.get('sku') or '')
+            if not sku:
+                continue
+            row = self.rows[sku]
+            commission = p.get('commission') or {}
+            revenue = number(commission.get('sale_amount'))
+            if revenue:
+                qty = number(p.get('quantity') or 1)
+                signed_qty = -qty if revenue < 0 else qty
+                row['sales_qty' if revenue > 0 else 'returns_qty'] += signed_qty
+                row['revenue'] += revenue
+                row['buyer_revenue'] += abs(number(commission.get('sale_price'))) * signed_qty
+                row['revenue_rf'] += revenue
+                row['buyer_rf'] += abs(number(commission.get('sale_price'))) * signed_qty
+                row['commission_rf'] -= number(commission.get('commission'))
+                self.sale_days[sku][str(payload['date'])[:7]] += abs(number(commission.get('sale_price'))) * signed_qty
+                row['commission'] -= number(commission.get('commission'))
+                if revenue>0 and payload.get('unit_number'):
+                    original=self.domestic_sales[(str(payload['unit_number']),sku)]
+                    original['quantity']+=qty
+                    original['gross']+=revenue
+                    original['receipt']+=abs(number(commission.get('sale_price')))*qty
+                    original['deduction']-=number(commission.get('commission'))
+            delivery = p.get('delivery') or {}
+            services = delivery.get('services') or []
+            for fee in services:
+                self.fee(sku, fee)
+            row['other_services'] -= number(delivery.get('total_accrued')) - sum(number(f.get('accrued')) for f in services)
+        for item in (payload.get('item_fees') or {}).get('fees') or []:
+            for fee in item.get('fees') or []:
+                self.fee(item.get('sku'), fee)
+        non_item = payload.get('non_item_fee')
+        if non_item:
+            self.fee(None, non_item)
+            if int(non_item.get('type_id') or 0) in {41,75}:
+                self.campaign_charges[(str(payload.get('date')),str(payload.get('unit_number')))] -= number(non_item.get('accrued'))
+        for fee in (payload.get('container_fees') or {}).get('fees') or []:
+            self.fee(None, fee)
+        # Keep every remaining money movement. Never drop an unsupported shape.
+        remainder = number(payload.get('total_amount')) - (self.net() - before)
+        self.pool['other_accruals'] -= remainder
+
+    def net(self):
+        return sum(r['revenue'] - r['commission'] - sum(r[e] for e in EXPENSES) for r in self.rows.values()) - sum(self.pool.values())
+
+    def add_buyouts(self,day,payload):
+        from .ozon_buyouts import parse_buyouts
+        for record in parse_buyouts(payload):
+            identity=(record['posting_number'],record['sku'])
+            if identity in self.seen_buyouts:
+                if self.seen_buyouts[identity]!=record:
+                    raise ValueError('Conflicting buyout rows for the same posting/SKU')
+                self.buyout_overlap_count+=1
+                continue
+            self.seen_buyouts[identity]=record
+            sku=record['sku'];row=self.rows[sku]
+            original=self.domestic_sales.get((record['posting_number'],sku))
+            if original:
+                # Already booked as a sale: classify it, never add a second sale or receipt.
+                self.buyout_overlap_count+=1
+                row['sales_qty']-=original['quantity']
+                row['sales_cis']+=original['quantity']
+                for target,field in [('revenue','gross'),('buyer','receipt'),('commission','deduction')]:
+                    row[target+'_rf']-=original[field]
+                    row[target+'_cis']+=original[field]
+                continue
+            row['sales_cis']+=record['quantity']
+            row['revenue']+=record['gross']
+            row['revenue_cis']+=record['gross']
+            row['buyer_revenue']+=record['receipt']
+            row['buyer_cis']+=record['receipt']
+            row['commission']+=record['deduction']
+            row['commission_cis']+=record['deduction']
+            self.sale_days[sku][str(day)[:7]]+=record['receipt']
+            self.cis_sale_days[sku][str(day)[:7]]+=record['receipt']
+            self.buyout_receipts+=record['receipt']
+            self.raw_total+=record['receipt']
+
+    def allocate(self):
+        # User policy: never spread expenses across articles without a verified SKU.
+        original_pool = dict(self.pool)
+        for key, amount in original_pool.items():
+            if amount:
+                self.rows['unallocated'][key] += amount
+        self.pool.clear()
+        if abs(self.net() - self.raw_total) > CENT:
+            raise ValueError('Article attribution does not reconcile to the raw accruals')
+        return original_pool
+
+    def bind_ad_costs(self, records):
+        """Move verified campaign/day/SKU spend out of the unmatched row, once."""
+        linked=ZERO
+        matched=set()
+        for day,campaign,sku,cost in records:
+            key=(str(day),str(campaign))
+            if key not in self.campaign_charges:
+                continue
+            amount=number(cost)
+            if amount:
+                self.rows[str(sku)]['marketing'] += amount
+                self.rows['unallocated']['marketing'] -= amount
+                linked += amount
+                matched.add(key)
+        if abs(self.net()-self.raw_total)>CENT:
+            raise ValueError('Performance binding changed the source finance total')
+        return linked,len(matched)
+
+
+def metric_row(values):
+    """All unit averages and ratios use the totals; never average article percentages."""
+    r = dict(values)
+    qty = r['sales_qty'] + r['returns_qty'] + (r.get('cis_qty',r.get('sales_cis',ZERO)) or ZERO)
+    r['qty'] = qty
+    r['mp_cost'] = sum(r[k] for k in EXPENSES if k != 'marketing')
+    r['operating'] = None if r.get('cogs') is None else r['revenue'] - r['commission'] - r['cogs'] - r['mp_cost'] - r['marketing']
+    r['profit'] = None if r['operating'] is None or r.get('tax') is None or r.get('external') is None else r['operating'] - r['external'] - r['tax']
+    money_keys = ('revenue', 'buyer_revenue', 'commission', 'cogs', 'mp_cost', *EXPENSES, 'operating', 'external', 'tax', 'profit')
+    for key in money_keys:
+        value = r.get(key)
+        r[key + '_unit'] = value / qty if value is not None and qty > 0 else None
+        r[key + '_pct'] = value / r['revenue'] if value is not None and r['revenue'] > 0 else None
+    r['roi'] = r['profit'] / r['cogs'] if r['profit'] is not None and r.get('cogs') and r['cogs'] > 0 else None
+    return r
